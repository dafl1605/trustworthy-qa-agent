# Documentation only; never put real secrets here.
# Configure actual secrets in the cloud environment's secure settings.
PORT=3001
DATABASE_PATH=./data/demo.sqlite
# Local test harness (QA-05). Must stay off by default; never a public route.
TQA_HARNESS=0
TQA_HARNESS_TOKEN=
LLM_PROVIDER=placeholder
LLM_API_KEY=
# Vite frontend can use a local dev-server proxy; avoid exposing server secrets via VITE_ variables.
