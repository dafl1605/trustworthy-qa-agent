# Documentation only; never put real secrets here.
# Configure actual secrets in the cloud environment's secure settings.
PORT=3001
DATABASE_PATH=./data/demo.sqlite
# Local fault harness. Stays unmounted unless both of these are set.
# TQA_HARNESS must be the exact value 1. The token must be non-empty.
# Never commit a real token. The API binds 127.0.0.1 only.
TQA_HARNESS=0
TQA_HARNESS_TOKEN=
LLM_PROVIDER=placeholder
LLM_API_KEY=
# Vite frontend can use a local dev-server proxy; avoid exposing server secrets via VITE_ variables.
# Dev and preview forward /api to TQA_API_ORIGIN, or to http://127.0.0.1:3001 when it is unset.
# QA-06 Playwright chooses its own loopback ports and a throwaway harness token. Do not commit that token.
# TQA_API_ORIGIN=http://127.0.0.1:3001
